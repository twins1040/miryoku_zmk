#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"

&mmv {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&u_mt {
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // 좌측 검지 세로 T + G → ESC (같은 손가락이라 롤링 오작동 없음)
        combo_esc {
            timeout-ms = <50>;
            layers = <U_BASE>;
            key-positions = <5 17>; // T, G
            bindings = <&kp ESC>;
        };

        // 우측 검지 세로 Y + H → 한/영 (F13)
        combo_lang {
            timeout-ms = <50>;
            layers = <U_BASE>;
            key-positions = <6 18>; // Y, H
            bindings = <&kp F13>;
        };

        // 좌측 코네 부트로더 진입 (하단 Z + X + C 동시 누름)
        combo_bootloader_left {
            timeout-ms = <60>;
            key-positions = <25 26 27>; // Z, X, C
            bindings = <&bootloader>;
        };
    };
};
